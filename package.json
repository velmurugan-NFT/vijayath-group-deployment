{
  "name": "vijayanth-pm-prototype",
  "private": true,
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "predev": "lsof -ti:3001 | xargs kill -9 2>/dev/null || true",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "db:reset": "prisma db push --force-reset --accept-data-loss && npm run db:seed",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "bcrypt": "^5.1.1",
    "@prisma/client": "^5.22.0",
    "concurrently": "^9.1.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
